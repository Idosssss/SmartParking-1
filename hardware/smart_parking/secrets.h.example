// secrets.h.example
//
// Copy this file to "secrets.h" (same folder) and fill in your own values.
// secrets.h is in .gitignore, so passwords never end up on GitHub.
// Only needed when ENABLE_WIFI is 1 in config.h.
#pragma once

#define WIFI_SSID "your-wifi-name"
#define WIFI_PASSWORD "your-wifi-password"
#define DEVICE_HOSTNAME "smart-parking"   // reachable as http://smart-parking.local
#define OTA_PASSWORD "change-me"          // password for over-the-air updates
