{
  "name": "smart-parking-lot",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "simulate": "tsx simulation/run.ts",
    "simulate:report": "tsx simulation/build-report.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:firmware": "sh hardware/tests/run.sh",
    "check": "npm run lint && npm run build && npm test && npm run test:firmware",
    "test:e2e": "node tests/e2e/board.e2e.mjs && node tests/e2e/parking.e2e.mjs"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
